{
    "compilerOptions": {
        "moduleResolution": "bundler",
        "module": "ESNext",
        "target": "es2022",
        "lib": ["es2022", "dom"],
        "types": ["node"],
        "declaration": true,
        "sourceMap": true,
        "outDir": "dist",
        "strict": true,
        "noImplicitOverride": true,
        "noImplicitReturns": true,
        "noUnusedLocals": true,
        "skipLibCheck": true,
        "baseUrl": ".",
        "paths": {
            "@cyanmycelium/mcp-vault": ["src/index.ts"],
            "@cyanmycelium/mcp-vault/conformance": ["src/conformance/index.ts"]
        }
    },
    "include": ["src/**/*.ts", "tests/**/*.ts", "vitest.config.ts", "vitest.live.config.ts", "tsup.config.ts"],
    "exclude": ["node_modules", "dist"]
}
